      "theory": {
        "type": "rule",
        "text": {
          "en": "For **one person**, the pronoun comes before the verb:\n\n- `je`: I\n- `tu`: you (a friend)\n- `il`: he\n- `elle`: she",
          "de": "Für **eine Person** steht das Pronomen vor dem Verb:\n\n- `je`: ich\n- `tu`: du\n- `il`: er\n- `elle`: sie"
        },
        "table": null,
        "examples": [
          {
            "text": "Je suis à Paris.",
            "highlight": ["Je"],
            "translation": { "en": "I am in Paris.", "de": "Ich bin in Paris." }
          },
          {
            "text": "Voici Léa. Elle est avec Marc.",
            "highlight": ["Elle"],
            "translation": { "en": "This is Léa. She is with Marc.", "de": "Das ist Léa. Sie ist mit Marc zusammen." }
          }
        ],
        "tip": {
          "en": "The forms suis, es, est come from être (to be); you will learn them soon.",
          "de": "Die Formen suis, es, est kommen von être (sein); du lernst sie bald."
        }
      },
